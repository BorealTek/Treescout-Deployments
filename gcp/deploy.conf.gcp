#===============================================================================
# TreeScout GCP Deployment Configuration
#
# ┌─────────────────────────────────────────────────────────────────────────┐
# │  FIRST-TIME SETUP                                                       │
# │  1. Create all secrets in GCP Secret Manager:                           │
# │       bash deployment/gcp/gcp-secrets-bootstrap.sh                     │
# │  2. Fill in non-secret values below (DOMAIN_NAME, ALLOWED_SOURCE_RANGES)│
# │  3. Validate:  bash deployment/gcp/gcp-config-validate.sh              │
# │  4. Deploy:    sudo bash deployment/gcp/gcp_deploy.sh                  │
# └─────────────────────────────────────────────────────────────────────────┘
#
# This file is committed to git as the template — it contains NO real secrets.
# deploy.conf (created automatically from this file on first run) is gitignored.
#===============================================================================

#===============================================================================
# SECRET MANAGER (master switch)
# Sensitive credentials are pulled from GCP Secret Manager at deploy time.
# Set to "false" only for local/non-GCP testing; supply plaintext fallbacks then.
#===============================================================================
USE_GCP_SECRET_MANAGER="true"

#===============================================================================
# INSTALLATION
#===============================================================================
GIT_REPO_URL="https://github.com/BorealTek/Treescout-Core.git"
GIT_BRANCH="laravel-11-foundation"
DEFAULT_INSTALL_DIR="/opt/treescout-docker"
GCP_PROJECT_ID=""       # Auto-detected from instance metadata when blank
GCP_ZONE="us-central1-a"

#===============================================================================
# NETWORK
#===============================================================================
# Domain name or GCP external IP (e.g. 34.0.0.1.nip.io for testing)
DOMAIN_NAME="treescout.example.com"       # ← REQUIRED: change before deploying

# Expose application via GCP Firewall rules (set false for internal-only)
EXPOSE_PUBLIC_PORTS="true"
GCP_FIREWALL_RULE_NAME="allow-treescout-https"

# Allowed source CIDRs  — must be set explicitly (no default to force a decision)
# Examples:  "203.0.113.0/24"  |  "10.0.0.0/8"  |  "0.0.0.0/0" (public, use with care)
ALLOWED_SOURCE_RANGES=""                  # ← REQUIRED: set before deploying

DOCKER_SUBNET="172.20.0.0/16"

#===============================================================================
# DATABASE
#===============================================================================
# Use "db" for the embedded Docker container; set to Cloud SQL private IP for prod.
DB_HOST="db"
DB_USER="treescout"
DB_NAME="treescout"

# Database root password
# Leave blank when USE_GCP_SECRET_MANAGER=true — pulled from Secret Manager.
DB_ROOT_PASS=""
DB_ROOT_PASS_SECRET="treescout-db-root-pass"

# Database application-user password
DB_PASS=""
DB_PASS_SECRET="treescout-db-pass"

#===============================================================================
# APPLICATION USERS  (seeded on first install)
#===============================================================================

# 1. Admin — full system access
ADMIN_EMAIL="admin@example.com"           # ← REQUIRED: change before deploying
ADMIN_FIRST_NAME="System"
ADMIN_LAST_NAME="Administrator"
ADMIN_PASS=""
ADMIN_PASS_SECRET="treescout-admin-pass"

# 2. Agent — standard support access
# Uncomment to seed this user on first deploy. Leave commented to skip.
# AGENT_EMAIL="agent@example.com"
# AGENT_FIRST_NAME="Support"
# AGENT_LAST_NAME="Agent"
# AGENT_PASS=""
# AGENT_PASS_SECRET="treescout-agent-pass"

# 3. Finance — billing & invoice access
# Uncomment to seed this user on first deploy. Leave commented to skip.
# FINANCE_EMAIL="finance@example.com"
# FINANCE_FIRST_NAME="Finance"
# FINANCE_LAST_NAME="Manager"
# FINANCE_PASS=""
# FINANCE_PASS_SECRET="treescout-finance-pass"

# 4. Reporter — read-only access
# Uncomment to seed this user on first deploy. Leave commented to skip.
# REPORTER_EMAIL="reporter@example.com"
# REPORTER_FIRST_NAME="Report"
# REPORTER_LAST_NAME="Viewer"
# REPORTER_PASS=""
# REPORTER_PASS_SECRET="treescout-reporter-pass"

#===============================================================================
# SSL / TLS
#===============================================================================
# Public HTTPS edge for gcp-server-init.sh (Caddy + Let's Encrypt).
# Requires:
#   - DOMAIN_NAME points to this VM public IP
#   - Ports 80 and 443 reachable from the internet
ENABLE_HTTPS="true"

# ACME contact email for certificate issuance/renewal.
# If blank, ADMIN_EMAIL is used.
TLS_EMAIL=""

#===============================================================================
# INTEGRATIONS  (optional)
#===============================================================================

# Google OAuth — create credentials at https://console.cloud.google.com/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_ID_SECRET="treescout-google-client-id"

GOOGLE_CLIENT_SECRET=""
GOOGLE_CLIENT_SECRET_SECRET="treescout-google-client-secret"

# Comma-separated emails auto-promoted to admin on first OAuth sign-in
GOOGLE_ADMIN_EMAILS=""
GOOGLE_ADMIN_EMAILS_SECRET="treescout-google-admin-emails"

# Comma-separated domains that are auto-provisioned as internal users
GOOGLE_ALLOWED_DOMAINS=""
GOOGLE_ALLOWED_DOMAINS_SECRET="treescout-google-allowed-domains"

# Action1 RMM API Keys (3 roles: Sync / Run / Manage — least-privilege)
# Region: us | eu | ap
ACTION1_REGION="us"

ACTION1_SYNC_CLIENT_ID=""
ACTION1_SYNC_CLIENT_ID_SECRET="treescout-action1-sync-client-id"
ACTION1_SYNC_CLIENT_SECRET=""
ACTION1_SYNC_CLIENT_SECRET_SECRET="treescout-action1-sync-client-secret"

ACTION1_AUTOMATION_RUNNER_CLIENT_ID=""
ACTION1_AUTOMATION_RUNNER_CLIENT_ID_SECRET="treescout-action1-automation-runner-client-id"
ACTION1_AUTOMATION_RUNNER_CLIENT_SECRET=""
ACTION1_AUTOMATION_RUNNER_CLIENT_SECRET_SECRET="treescout-action1-automation-runner-client-secret"

ACTION1_SCRIPT_MANAGER_CLIENT_ID=""
ACTION1_SCRIPT_MANAGER_CLIENT_ID_SECRET="treescout-action1-script-manager-client-id"
ACTION1_SCRIPT_MANAGER_CLIENT_SECRET=""
ACTION1_SCRIPT_MANAGER_CLIENT_SECRET_SECRET="treescout-action1-script-manager-client-secret"

#===============================================================================
# KROKI — Standalone Diagram Renderer (optional)
#===============================================================================
# Set to "true" to auto-start the Kroki container alongside the app stack.
# Required only when the MiddleMan module's topology/diagram features are used.
ENABLE_KROKI="false"
KROKI_PORT="8001"
MIDDLEMAN_KROKI_URL="http://host.docker.internal:8001"
MIDDLEMAN_KROKI_TIMEOUT="10"

#===============================================================================
# MODULES
#===============================================================================
# GitHub PAT — required to clone private BorealTek module repositories.
# Leave blank when USE_GCP_SECRET_MANAGER=true (pulled from Secret Manager).
# Do NOT commit a real token here.
export REPO_TOKEN=""
REPO_TOKEN_SECRET="treescout-repo-token"

# Modules to install.  Format: "Name|RepoURL|REPO_TOKEN|Branch"
# See deployment/linux/modules.manifest.json for all available modules and profiles.
#
# FULL (BorealTek internal — all 18 modules):
MODULES_TO_INSTALL=(
    "Action1|https://github.com/BorealTek/Action1-Module.git|REPO_TOKEN|main"
    "Alerts|https://github.com/BorealTek/Alerts-Module.git|REPO_TOKEN|main"
    "AppHealth|https://github.com/BorealTek/AppHealth-Module.git|REPO_TOKEN|main"
    "AssetManagement|https://github.com/BorealTek/AssetManagement-Module.git|REPO_TOKEN|main"
    "CaseManager|https://github.com/BorealTek/CaseManager-Module.git|REPO_TOKEN|main"
    "ClientPortal|https://github.com/BorealTek/ClientPortal-Module.git|REPO_TOKEN|main"
    "ContractManager|https://github.com/BorealTek/ContractManager-Module.git|REPO_TOKEN|main"
    "Crm|https://github.com/BorealTek/Crm-Module.git|REPO_TOKEN|main"
    "DevFeedback|https://github.com/BorealTek/DevFeedback-Module.git|REPO_TOKEN|main"
    "EmailMigration|https://github.com/BorealTek/EmailMigration-Module.git|REPO_TOKEN|main"
    "GoogleAdmin|https://github.com/BorealTek/GoogleAdmin-Module.git|REPO_TOKEN|main"
    "KnowledgeBase|https://github.com/BorealTek/KnowledgeBase-Module.git|REPO_TOKEN|main"
    "MiddleMan|https://github.com/BorealTek/Treescout-MiddleMan.git|REPO_TOKEN|main"
    "PIB|https://github.com/BorealTek/PIB-Module.git|REPO_TOKEN|main"
    "Payment|https://github.com/BorealTek/Payment-Module.git|REPO_TOKEN|main"
    "SoftwareSubscriptions|https://github.com/BorealTek/SoftwareSubscriptions-Module.git|REPO_TOKEN|main"
    "DeploymentManager|https://github.com/BorealTek/DeploymentManager-Module.git|REPO_TOKEN|main"
    "WidgetRegistry|https://github.com/BorealTek/WidgetRegistry-Module.git|REPO_TOKEN|main"
)

# CORE-MSP (helpdesk + CRM + billing + assets + portal):
# MODULES_TO_INSTALL=(
#     "Crm|https://github.com/BorealTek/Crm-Module.git|REPO_TOKEN|main"
#     "PIB|https://github.com/BorealTek/PIB-Module.git|REPO_TOKEN|main"
#     "AssetManagement|https://github.com/BorealTek/AssetManagement-Module.git|REPO_TOKEN|main"
#     "ClientPortal|https://github.com/BorealTek/ClientPortal-Module.git|REPO_TOKEN|main"
#     "ContractManager|https://github.com/BorealTek/ContractManager-Module.git|REPO_TOKEN|main"
# )

# HELPDESK-ONLY (CRM + portal + knowledge base):
# MODULES_TO_INSTALL=(
#     "Crm|https://github.com/BorealTek/Crm-Module.git|REPO_TOKEN|main"
#     "ClientPortal|https://github.com/BorealTek/ClientPortal-Module.git|REPO_TOKEN|main"
#     "KnowledgeBase|https://github.com/BorealTek/KnowledgeBase-Module.git|REPO_TOKEN|main"
# )

#===============================================================================
# GCP MONITORING & LOGGING
#===============================================================================
# Ship Docker logs to GCP Cloud Logging via the Ops Agent (install instructions
# printed by gcp_deploy.sh when enabled).
ENABLE_GCP_LOGGING="true"

# GCP Cloud Monitoring — CPU / memory / disk metrics (auto-enabled on GCE)
ENABLE_GCP_MONITORING="true"

#===============================================================================
# BACKUP & DISASTER RECOVERY
#===============================================================================
# Automated database backups to GCP Cloud Storage.
# Requires: gsutil authenticated (or Workload Identity).
# ⚠ Set to "true" before going live — never run production without backups.
ENABLE_GCP_BACKUPS="false"
GCP_BACKUP_BUCKET=""        # Format: gs://my-bucket/treescout/
BACKUP_SCHEDULE="0 2 * * *" # Cron format — default: 02:00 UTC daily

#===============================================================================
# MAINTENANCE & DEBUGGING
#===============================================================================
VERBOSE_LOGGING="false"
KEEP_ARTIFACTS="false"

# Set "true" to preserve existing database on redeploy (no data loss).
# ⚠ First deploy on a fresh VM: this has no effect.
REUSE_DB="true"

# Set "true" to skip admin password reset on redeploy.
PRESERVE_ADMIN_PASS="true"
