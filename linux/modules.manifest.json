{
  "_comment": "Single source of truth for all module repositories and deployment profiles. Read by scripts/setup-modules.sh and deployment/docker/docker_deploy.sh.",
  "core": {
    "_comment": "The main application repo. PUBLIC — no token required.",
    "repo": "https://github.com/BorealTek/Treescout-Core.git",
    "branch": "main",
    "private": false
  },
  "modules": {
    "_comment": "All module repos are PRIVATE (github.com/BorealTek/*). REPO_TOKEN is required to clone or update them. Modules embedded directly in Treescout-Core (Reporting, TimeTracking, Prospects) are not listed here — they ship with the core clone.",
    "Crm": {
      "repo": "https://github.com/BorealTek/Crm-Module.git",
      "branch": "main",
      "private": true,
      "description": "Client & contact management, custom customer fields"
    },
    "AssetManagement": {
      "repo": "https://github.com/BorealTek/AssetManagement-Module.git",
      "branch": "main",
      "private": true,
      "description": "Hardware and software asset inventory",
      "requires": [
        "Crm"
      ]
    },
    "SoftwareSubscriptions": {
      "repo": "https://github.com/BorealTek/SoftwareSubscriptions-Module.git",
      "branch": "main",
      "private": true,
      "description": "Per-seat software license tracking",
      "requires": [
        "Crm"
      ]
    },
    "ClientPortal": {
      "repo": "https://github.com/BorealTek/ClientPortal-Module.git",
      "branch": "main",
      "private": true,
      "description": "Customer-facing self-service portal with separate auth guard",
      "requires": [
        "Crm"
      ]
    },
    "KnowledgeBase": {
      "repo": "https://github.com/BorealTek/KnowledgeBase-Module.git",
      "branch": "main",
      "private": true,
      "description": "Internal and external documentation / knowledge base"
    },
    "GoogleAdmin": {
      "repo": "https://github.com/BorealTek/GoogleAdmin-Module.git",
      "branch": "main",
      "private": true,
      "description": "Google Workspace user sync"
    },
    "Alerts": {
      "repo": "https://github.com/BorealTek/Alerts-Module.git",
      "branch": "main",
      "private": true,
      "description": "Notification and alert subscription rules"
    },
    "Action1": {
      "repo": "https://github.com/BorealTek/Action1-Module.git",
      "branch": "main",
      "private": true,
      "description": "Action1 RMM tool integration"
    },
    "WidgetRegistry": {
      "repo": "https://github.com/BorealTek/WidgetRegistry-Module.git",
      "branch": "main",
      "private": true,
      "description": "Composable widget slot system for UI composition"
    },
    "CaseManager": {
      "repo": "https://github.com/BorealTek/CaseManager-Module.git",
      "branch": "main",
      "private": true,
      "description": "AI-Powered Tier 0 Case Manager — triage, research, and knowledge engine"
    }
  },
  "profiles": {
    "full": {
      "description": "All modules — BorealTek internal deployment",
      "modules": [
        "Crm",
        "AssetManagement",
        "SoftwareSubscriptions",
        "ClientPortal",
        "KnowledgeBase",
        "GoogleAdmin",
        "Alerts",
        "Action1",
        "WidgetRegistry",
        "CaseManager"
      ]
    },
    "core-msp": {
      "description": "Standard MSP client — helpdesk + CRM + assets + portal",
      "modules": [
        "Crm",
        "AssetManagement",
        "SoftwareSubscriptions",
        "ClientPortal",
        "Alerts",
        "WidgetRegistry"
      ]
    },
    "helpdesk-only": {
      "description": "Minimal install — ticketing and CRM only, no billing",
      "modules": [
        "Crm",
        "KnowledgeBase",
        "ClientPortal",
        "WidgetRegistry"
      ]
    },
    "google-workspace-msp": {
      "description": "MSP with Google Workspace user management",
      "modules": [
        "Crm",
        "AssetManagement",
        "SoftwareSubscriptions",
        "ClientPortal",
        "GoogleAdmin",
        "Alerts",
        "WidgetRegistry"
      ]
    }
  }
}
