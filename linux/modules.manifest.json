{
  "_comment": "Single source of truth for all module repositories. Read by scripts/setup-modules.sh and deployment/docker/docker_deploy.sh. Do not add '_comment' keys inside 'modules' or 'profiles' below — both objects are enumerated with 'keys[]'/'to_entries[]' and a stray '_comment' key gets treated as a real entry.",
  "core": {
    "_comment": "The main application repo. PUBLIC — no token required.",
    "repo": "https://github.com/BorealTek/Treescout-Core.git",
    "branch": "main",
    "private": false
  },
  "modules": {
    "Action1": {
      "repo": "https://github.com/BorealTek/Action1-Module.git",
      "branch": "main",
      "private": true,
      "description": "Action1 RMM integration — endpoint sync, remote script execution"
    },
    "Alerts": {
      "repo": "https://github.com/BorealTek/Alerts-Module.git",
      "branch": "main",
      "private": true,
      "description": "Notification and alert subscription rules"
    },
    "AssetManagement": {
      "repo": "https://github.com/BorealTek/AssetManagement-Module.git",
      "branch": "main",
      "private": true,
      "description": "Hardware and software asset inventory",
      "requires": ["Crm"]
    },
    "CaseManager": {
      "repo": "https://github.com/BorealTek/CaseManager-Module.git",
      "branch": "main",
      "private": true,
      "description": "AI-powered tier-0 case triage, research, and knowledge engine"
    },
    "ClientPortal": {
      "repo": "https://github.com/BorealTek/ClientPortal-Module.git",
      "branch": "main",
      "private": true,
      "description": "Customer-facing self-service portal with separate auth guard",
      "requires": ["Crm"]
    },
    "ContractManager": {
      "repo": "https://github.com/BorealTek/ContractManager-Module.git",
      "branch": "main",
      "private": true,
      "description": "Client contract lifecycle tracking"
    },
    "Crm": {
      "repo": "https://github.com/BorealTek/Crm-Module.git",
      "branch": "main",
      "private": true,
      "description": "Client and contact management, custom customer fields"
    },
    "DeploymentManager": {
      "repo": "https://github.com/BorealTek/DeploymentManager-Module.git",
      "branch": "main",
      "private": true,
      "description": "Software deployment tracking and rollout management"
    },
    "EmailMigration": {
      "repo": "https://github.com/BorealTek/EmailMigration-Module.git",
      "branch": "main",
      "private": true,
      "description": "Mailbox migration tooling"
    },
    "GoogleAdmin": {
      "repo": "https://github.com/BorealTek/GoogleAdmin-Module.git",
      "branch": "main",
      "private": true,
      "description": "Google Workspace user sync and admin automation"
    },
    "KnowledgeBase": {
      "repo": "https://github.com/BorealTek/KnowledgeBase-Module.git",
      "branch": "main",
      "private": true,
      "description": "Internal and external documentation / knowledge base"
    },
    "PIB": {
      "repo": "https://github.com/BorealTek/PIB-Module.git",
      "branch": "main",
      "private": true,
      "description": "PIB integration module"
    },
    "Payment": {
      "repo": "https://github.com/BorealTek/Payment-Module.git",
      "branch": "main",
      "private": true,
      "description": "Payment processing integration"
    },
    "SoftwareSubscriptions": {
      "repo": "https://github.com/BorealTek/SoftwareSubscriptions-Module.git",
      "branch": "main",
      "private": true,
      "description": "Per-seat software license tracking",
      "requires": ["Crm"]
    },
    "WidgetRegistry": {
      "repo": "https://github.com/BorealTek/WidgetRegistry-Module.git",
      "branch": "main",
      "private": true,
      "description": "Composable widget slot system for UI composition"
    }
  },
  "profiles": {
    "full": {
      "description": "All separately-repo'd modules",
      "modules": [
        "Action1",
        "Alerts",
        "AssetManagement",
        "CaseManager",
        "ClientPortal",
        "Crm",
        "GoogleAdmin",
        "KnowledgeBase",
        "SoftwareSubscriptions",
        "WidgetRegistry"
      ]
    }
  }
}
