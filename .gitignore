# Ignore local configuration with secrets
linux/deploy.conf
linux/deploy\ copy.conf
linux/deploy*.conf
!linux/deploy.conf.example

# Auto-generated secrets (lives at $DEFAULT_INSTALL_DIR/secrets.env on the server)
secrets.env

# Ignore SSL certificates generated during deployment
nginx/ssl/
*.pem
*.key

# Ignore local Cloudflared credentials
docker/cloudflared/.env

# Ignore system files
.DS_Store
Thumbs.db
